[gd_scene format=3]

[ext_resource type="Theme" path="res://src/ui/reading_theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://src/ui/safe_area_margins.gd" id="2_safe"]
[ext_resource type="Script" path="res://src/boot/boot.gd" id="3_boot"]

[node name="Boot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
mouse_filter = 2
script = ExtResource("3_boot")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Safe" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 96
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 72
mouse_filter = 2
script = ExtResource("2_safe")

[node name="Column" type="VBoxContainer" parent="Safe"]
layout_mode = 2
mouse_filter = 2
alignment = 1

[node name="Title" type="Label" parent="Safe/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Критический провал"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Status" type="Label" parent="Safe/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
horizontal_alignment = 1
autowrap_mode = 3
